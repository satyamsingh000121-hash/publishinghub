# Database (Prisma SQLite)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://nxvprwogwfzvdjtervxu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Stripe TEST Mode (Replace with your actual keys in .env.local)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_CURRENCY=gbp

# Resend Email Service
# - Testing (account owner only): RESEND_FROM_EMAIL="The Publishing Hub <onboarding@resend.dev>"
# - Production (all users): Verify domain at https://resend.com/domains, then set:
#   RESEND_FROM_EMAIL="The Publishing Hub <welcome@yourdomain.com>"
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="The Publishing Hub <onboarding@resend.dev>"

# Application Base URL (e.g. https://your-domain.vercel.app in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000